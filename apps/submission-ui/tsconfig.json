{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"noEmit": true,
		"allowImportingTsExtensions": true,
		/* Bundler mode */
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
		},
	},
	"include": ["src", "vite.config.ts", "eslint.config.js", "@types/i18next.d.ts"],
}
